{
  "publishedCli": {
    "version": "0.21.1",
    "sourceCommit": "6d024125ce7291e7a7d7ba4a5400f8415e54e3c9"
  },
  "removable": [],
  "$defs": {
    "AcceptanceRecord": {
      "properties": {
        "checkedAt": {
          "format": "date-time",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/RecordedCheck"
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        },
        "recordedBy": {
          "type": "string"
        },
        "structured": {
          "default": false,
          "description": "The record has structured checks, not only a note (0.7.0 servers: default list only).",
          "type": "boolean"
        }
      },
      "required": [
        "recordedBy",
        "note",
        "checks",
        "structured",
        "checkedAt"
      ],
      "type": "object"
    },
    "AdminApprovalExample": {
      "description": "A current installation with release permissions awaiting administrator approval.",
      "properties": {
        "appId": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "appId",
        "name",
        "environment"
      ],
      "type": "object"
    },
    "AdminDirectoryUser": {
      "description": "An administrator's account directory entry, including disabled accounts.",
      "properties": {
        "admin": {
          "type": "boolean"
        },
        "canDevelop": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "primaryGroupId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "primaryGroupName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "admin",
        "canDevelop",
        "enabled",
        "primaryGroupId",
        "primaryGroupName"
      ],
      "type": "object"
    },
    "AdminOverviewResponse": {
      "description": "`GET /api/v1/admin/overview`: totals and independent pages of installations.",
      "properties": {
        "approvalExamples": {
          "items": {
            "$ref": "#/$defs/AdminApprovalExample"
          },
          "type": "array"
        },
        "approvalNextCursor": {
          "description": "Pass as `approvalCursor` to read the next page of pending approvals.",
          "type": [
            "string",
            "null"
          ]
        },
        "pendingApprovals": {
          "format": "int64",
          "type": "integer"
        },
        "pendingRegistrations": {
          "format": "int64",
          "type": "integer"
        },
        "runtimeExamples": {
          "items": {
            "$ref": "#/$defs/AdminRuntimeExample"
          },
          "type": "array"
        },
        "runtimeIssues": {
          "format": "int64",
          "type": "integer"
        },
        "runtimeNextCursor": {
          "description": "Pass as `runtimeCursor` to read the next page of runtime issues.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pendingRegistrations",
        "pendingApprovals",
        "runtimeIssues",
        "approvalExamples",
        "runtimeExamples",
        "approvalNextCursor",
        "runtimeNextCursor"
      ],
      "type": "object"
    },
    "AdminRuntimeExample": {
      "description": "A current installation with a runtime problem.",
      "properties": {
        "appId": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "issue": {
          "$ref": "#/$defs/AdminRuntimeIssue"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "appId",
        "name",
        "environment",
        "issue"
      ],
      "type": "object"
    },
    "AdminRuntimeIssue": {
      "enum": [
        "failed",
        "recovery_required",
        "unreachable",
        "unexpected_stop",
        "degraded",
        "unhealthy"
      ],
      "type": "string"
    },
    "AdminUserDirectoryPage": {
      "description": "`GET /api/v1/users/directory`: an administrator's filtered account directory.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AdminDirectoryUser"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Pass as `cursor` with the same filters and credential context for the next page.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "type": "object"
    },
    "App": {
      "properties": {
        "disabled": {
          "default": false,
          "description": "The company's use switch applies even before the first installation.",
          "type": "boolean"
        },
        "distribution": {
          "$ref": "#/$defs/AppDistribution",
          "default": "organization",
          "description": "Product catalog membership, including products without an installed release."
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "distribution",
        "disabled"
      ],
      "type": "object"
    },
    "AppDetail": {
      "description": "`GET /api/v1/apps/{app}`: the app and the installations this credential may use.",
      "properties": {
        "app": {
          "$ref": "#/$defs/App"
        },
        "installations": {
          "items": {
            "$ref": "#/$defs/Installation"
          },
          "type": "array"
        }
      },
      "required": [
        "app",
        "installations"
      ],
      "type": "object"
    },
    "AppDistribution": {
      "enum": [
        "default_official",
        "optional_official",
        "organization"
      ],
      "type": "string"
    },
    "AppFrameLaunch": {
      "description": "A one-time launch of one installation's app frame (`POST /api/v1/app-frames`).\nThe portal submits `code` in a form POST to `launchUrl` inside a new iframe.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Browser features the portal delegates to this frame (iframe `allow`):\n`clipboard-write`, `fullscreen`, from the release's approved `frame:*`\npermissions (docs/APP-FRAMES.md 3.5).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "frameId": {
          "description": "The frame this code opens; the portal renews it by this id.",
          "format": "uuid",
          "type": "string"
        },
        "frameOrigin": {
          "description": "The installation's own origin; never shared with another installation.",
          "type": "string"
        },
        "installationId": {
          "format": "uuid",
          "type": "string"
        },
        "launchUrl": {
          "type": "string"
        },
        "releaseId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "frameId",
        "installationId",
        "releaseId",
        "frameOrigin",
        "launchUrl",
        "code",
        "expiresAt",
        "allow"
      ],
      "type": "object"
    },
    "AppFrameRenewal": {
      "description": "A one-time renew code for an open frame (`POST /api/v1/app-frames/{id}/renew`).",
      "properties": {
        "code": {
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "code",
        "expiresAt"
      ],
      "type": "object"
    },
    "AppFrameToken": {
      "description": "A frame's new API token (`POST /_miy/renew` on the frame origin).",
      "properties": {
        "token": {
          "type": "string"
        },
        "tokenExpiresAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "token",
        "tokenExpiresAt"
      ],
      "type": "object"
    },
    "AttachFile": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "description": "Opaque app-owned reference. The core does not interpret it as a path or ACL.",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "reference"
      ],
      "type": "object"
    },
    "AuditEntry": {
      "properties": {
        "action": {
          "type": "string"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "actorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "requestId": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "at",
        "actor",
        "actorName",
        "action",
        "target",
        "requestId"
      ],
      "type": "object"
    },
    "AuditPage": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/AuditEntry"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Pass as `before` to read older entries.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "entries",
        "nextCursor"
      ],
      "type": "object"
    },
    "BrowserSession": {
      "description": "One of the signed-in person's live browser sessions (`GET /api/v1/me/sessions`).",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "current": {
          "description": "The session this request was made with.",
          "type": "boolean"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "lastSeenAt": {
          "description": "Updated at most once a minute.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "description": "`portal`, `dev_portal` or `console`.",
          "type": "string"
        },
        "userAgent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "surface",
        "createdAt",
        "expiresAt",
        "lastSeenAt",
        "userAgent",
        "current"
      ],
      "type": "object"
    },
    "BrowserSessionPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BrowserSession"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "DateFormat": {
      "enum": [
        "korean",
        "iso",
        "us",
        "european",
        "locale"
      ],
      "type": "string"
    },
    "DetachFile": {
      "additionalProperties": false,
      "description": "Release an attached file. The app sends this only after the transaction that\nremoved its own reference has committed; Core then deletes the bytes.",
      "properties": {
        "reference": {
          "description": "The reference given at attach. A different value is refused.",
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "type": "object"
    },
    "DirectoryGroup": {
      "description": "An active group suitable for selection or current membership checks.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GroupSource"
        }
      },
      "required": [
        "id",
        "name",
        "source"
      ],
      "type": "object"
    },
    "DirectoryGroupRef": {
      "description": "Safe display information for an active primary HR group.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "DirectoryKind": {
      "description": "The explicitly requested view of the app-facing directory.",
      "oneOf": [
        {
          "enum": [
            "users",
            "groups"
          ],
          "type": "string"
        },
        {
          "const": "memberships",
          "description": "Current groups of the authenticated original user, never a supplied user id.",
          "type": "string"
        }
      ]
    },
    "DirectoryPage": {
      "description": "A bounded, name/id ordered app directory page. Only the requested collection is\npopulated. Membership pages always belong to `subjectId`; selection is not an ACL.",
      "properties": {
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/DirectoryGroup"
          },
          "type": "array"
        },
        "installationId": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DirectoryKind"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectId": {
          "type": "string"
        },
        "users": {
          "items": {
            "$ref": "#/$defs/DirectoryUser"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "subjectId",
        "installationId",
        "environment",
        "users",
        "groups",
        "nextCursor"
      ],
      "type": "object"
    },
    "DirectoryUser": {
      "description": "An active user's public directory fields. No administrator or grant data.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "primaryGroup": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectoryGroupRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "primaryGroup"
      ],
      "type": "object"
    },
    "Environment": {
      "enum": [
        "dev",
        "prod"
      ],
      "type": "string"
    },
    "FileStatus": {
      "enum": [
        "pending",
        "ready",
        "attached",
        "cancelled",
        "expired"
      ],
      "type": "string"
    },
    "FileTransfer": {
      "description": "How a reservation's bytes arrive.",
      "oneOf": [
        {
          "const": "single",
          "description": "One `PUT content` request, up to 10 MiB.",
          "type": "string"
        },
        {
          "const": "parts",
          "description": "Contiguous `PUT parts` ranges of up to 8 MiB, then `POST complete`; up to 2 GiB.",
          "type": "string"
        }
      ]
    },
    "FrameBootstrap": {
      "description": "What the frame document carries for the platform frame runtime\n(`<script id=\"miy-frame-bootstrap\" type=\"application/json\">`).",
      "properties": {
        "appId": {
          "type": "string"
        },
        "assetBase": {
          "description": "Same-origin prefix of the release UI files for this frame session.",
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "frameExpiresAt": {
          "description": "The frame session's fixed end; renewals never extend it.",
          "format": "date-time",
          "type": "string"
        },
        "frameId": {
          "format": "uuid",
          "type": "string"
        },
        "installationId": {
          "format": "uuid",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/FrameLocation"
        },
        "moduleEntry": {
          "type": "string"
        },
        "moduleExport": {
          "type": "string"
        },
        "parentOrigin": {
          "description": "The only window the frame talks to.",
          "type": "string"
        },
        "protocol": {
          "description": "Bridge protocol, `miy.frame/v1`.",
          "type": "string"
        },
        "releaseId": {
          "format": "uuid",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/FrameSettings",
          "description": "Display settings at launch. Later changes arrive as `settings.changed`."
        },
        "settingsAware": {
          "description": "Whether this release was built with an SDK bundle that understands\ndisplay settings. The runtime keeps older apps light and Korean.",
          "type": "boolean"
        },
        "token": {
          "type": "string"
        },
        "tokenExpiresAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "frameId",
        "installationId",
        "appId",
        "releaseId",
        "environment",
        "parentOrigin",
        "basePath",
        "location",
        "token",
        "tokenExpiresAt",
        "frameExpiresAt",
        "assetBase",
        "moduleEntry",
        "moduleExport",
        "contractVersion",
        "settings",
        "settingsAware"
      ],
      "type": "object"
    },
    "FrameLocation": {
      "description": "The app location inside its base path.",
      "properties": {
        "hash": {
          "type": "string"
        },
        "pathname": {
          "type": "string"
        },
        "search": {
          "type": "string"
        }
      },
      "required": [
        "pathname",
        "search",
        "hash"
      ],
      "type": "object"
    },
    "FrameSettings": {
      "description": "Display settings passed from the portal to an app frame. They decide how\nthings look and read; they are never an input to an access decision.",
      "properties": {
        "dateFormat": {
          "$ref": "#/$defs/DateFormat"
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        },
        "theme": {
          "$ref": "#/$defs/ThemePreference"
        },
        "timeZone": {
          "description": "IANA time zone name. The reader falls back when it does not know the zone.",
          "type": "string"
        }
      },
      "required": [
        "theme",
        "locale",
        "timeZone",
        "dateFormat"
      ],
      "type": "object"
    },
    "Group": {
      "properties": {
        "active": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "members": {
          "description": "Members now: users whose primary group it is (HR) or listed members (local).",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GroupSource"
        }
      },
      "required": [
        "id",
        "name",
        "source",
        "parentId",
        "active",
        "members"
      ],
      "type": "object"
    },
    "GroupSource": {
      "enum": [
        "hr",
        "local"
      ],
      "type": "string"
    },
    "Health": {
      "description": "The latest service observation; process state stays in `runtimeStatus`.",
      "properties": {
        "checkedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "consecutiveFailures": {
          "format": "int32",
          "type": "integer"
        },
        "errorCode": {
          "default": null,
          "description": "0.7.0 servers send it only in the default list.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        }
      },
      "required": [
        "status",
        "consecutiveFailures",
        "checkedAt",
        "errorCode"
      ],
      "type": "object"
    },
    "HealthStatus": {
      "oneOf": [
        {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy",
            "not_applicable"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Not observed yet; a status this client does not know also reads as unknown.",
          "type": "string"
        }
      ]
    },
    "HomeCard": {
      "description": "An app's summary card on the portal home. `status` is `ok`, or\n`unavailable` when the app did not answer in time (shown as \"\uac00\uc838\uc624\uc9c0 \ubabb\ud568\").",
      "properties": {
        "appId": {
          "type": "string"
        },
        "appName": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "installationId": {
          "format": "uuid",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/HomeCardItem"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "installationId",
        "appId",
        "appName",
        "status",
        "title",
        "count",
        "items"
      ],
      "type": "object"
    },
    "HomeCardItem": {
      "description": "One line of a home summary card (display text only).",
      "properties": {
        "at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "App-relative destination opened in the app's frame.",
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "path",
        "at"
      ],
      "type": "object"
    },
    "HomeCardPage": {
      "description": "`GET /api/v1/home/cards`.",
      "properties": {
        "cards": {
          "items": {
            "$ref": "#/$defs/HomeCard"
          },
          "type": "array"
        }
      },
      "required": [
        "cards"
      ],
      "type": "object"
    },
    "Installation": {
      "description": "An installation as the installation lists, the runtime management list and the app\ndetail return it. `canOpen`, `canManage` and `canPromote` are the decisions this\ncredential would get.",
      "properties": {
        "acceptance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptanceRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "The release's recorded test acceptance; present only with `canManage`."
        },
        "appDisabled": {
          "default": false,
          "description": "The company switch stops use of this app (0.7.0 servers: runtime management list only).",
          "type": "boolean"
        },
