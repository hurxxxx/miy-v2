{
  auto_https disable_redirects
}
(platform) {
  handle /api/* {
    reverse_proxy host.docker.internal:18080
  }
  handle /auth/* {
    reverse_proxy host.docker.internal:18080
  }
  handle /mcp* {
    reverse_proxy host.docker.internal:18080
  }
  handle /.well-known/* {
    reverse_proxy host.docker.internal:18080
  }
  handle /artifacts/* {
    reverse_proxy host.docker.internal:18080
  }
  handle {
    root * /srv/platform
    try_files {path} /index.html
    file_server
  }
}
https://localhost:18443 {
  tls internal
  handle /identity/* {
    reverse_proxy keycloak:8080
  }
  import platform
}
http://localhost:18000 {
  import platform
}
