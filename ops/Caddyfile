{
  auto_https disable_redirects
}
(platform) {
  handle /identity/* {
    reverse_proxy keycloak:8080
  }
  handle /api/* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle /auth/* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle /mcp* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle /.well-known/* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle /artifacts/* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle /cli/downloads/* {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle {
    root * /srv/platform
    try_files {path} /index.html
    file_server
  }
}
{$MIY_PROXY_TLS_SITE:https://localhost:18443} {
  tls internal
  import platform
}
http://:18000 {
  import platform
}
