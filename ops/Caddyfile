{
  auto_https disable_redirects
  # Host networking must not claim the host administrative listener.
  admin off
}
import /etc/caddy/routes.caddy
{$MIY_ORIGIN:https://localhost:18443} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  tls internal
  import portal
}
{$MIY_CONSOLE_ORIGIN:https://localhost:18444} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  tls internal
  import console
}
{$MIY_DEV_PORTAL_ORIGIN:https://localhost:18445} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  tls internal
  import devportal
}
# Preserve the old local entry URL without another session/identity surface.
http://:{$MIY_HTTP_PORT:18000} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  redir {$MIY_ORIGIN}{uri} 308
}
