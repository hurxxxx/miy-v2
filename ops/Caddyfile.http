{
  auto_https off
  admin off
}
import /etc/caddy/routes.caddy
{$MIY_ORIGIN:http://localhost:18000} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  import portal
}
{$MIY_CONSOLE_ORIGIN:http://localhost:18001} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  import console
}
{$MIY_DEV_PORTAL_ORIGIN:http://localhost:18002} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  import devportal
}
{$MIY_APP_FRAME_SITES} {
  bind {$MIY_PROXY_BIND:127.0.0.1}
  import appframe
}
