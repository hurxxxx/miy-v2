{
  auto_https off
}
http://:18000 {
  handle /identity/* {
    reverse_proxy keycloak:8080
  }
  @core path /api/* /auth/* /mcp* /.well-known/* /artifacts/* /cli/downloads/* /cli/installers/*
  handle @core {
    reverse_proxy {$MIY_CORE_UPSTREAM:host.docker.internal:18080}
  }
  handle {
    root * /srv/platform
    try_files {path} /index.html
    file_server
  }
}
