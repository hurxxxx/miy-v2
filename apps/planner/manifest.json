{
  "contractVersion": "miy.app/v1alpha1",
  "id": "planner",
  "migrations": {
    "directory": "migrations"
  },
  "name": "플래너",
  "panels": [
    {
      "id": "todos",
      "path": "/widgets/todos",
      "title": "할 일"
    },
    {
      "id": "memos",
      "path": "/widgets/memos",
      "title": "메모"
    }
  ],
  "platformEndpoints": {
    "homeCard": "/v1/home-card",
    "search": "/v1/search"
  },
  "requestedPermissions": [
    "database"
  ],
  "resources": {
    "database": "postgresql"
  },
  "runtime": {
    "profile": "rust-web-v1"
  },
  "ui": {
    "contractVersion": "miy.ui/v1alpha1",
    "delivery": "module",
    "moduleEntry": "mf-manifest.json",
    "moduleExport": "./AppRoot"
  },
  "version": "0.1.0"
}