  "components": {
    "schemas": {
      "ApiErrorDetails": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetails"
          }
        }
      },
      "CalendarEventMetadata": {
        "type": "object",
        "required": [
          "meetingId",
          "attendeeCount",
          "taskListId",
          "taskListKey",
          "taskNumber",
          "status",
          "assigneeIds",
          "plannerEventId",
          "ownerId",
          "ownerName",
          "location",
          "plannerAllDay",
          "plannerStartHasTime",
          "plannerEndHasTime",
          "plannerTimeZone",
          "externalCalendarId"
        ],
        "properties": {
          "assigneeIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "attendeeCount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "externalCalendarId": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "meetingId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "plannerAllDay": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "plannerEndHasTime": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "plannerEventId": {
            "type": [
              "string",
              "null"
