{
  "openapi": "3.1.0",
  "info": {
    "title": "플래너 API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/calendar/events": {
      "get": {
        "summary": "List the caller's own calendar events.",
        "operationId": "listCalendarEvents",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive lower bound. ISO date or datetime, with or without offset.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Exclusive upper bound, at most 366 days after from.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sources",
            "in": "query",
            "description": "Comma-separated sources. This app supports planner_event, the default.\nAn empty value selects no sources.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "planner_event"
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar events owned by the current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range or sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Platform identity could not be verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Missing from or to",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Could not read the calendar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
