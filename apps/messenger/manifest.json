{
  "contractVersion": "miy.app/v1alpha1",
  "id": "messenger",
  "migrations": {
    "directory": "migrations"
  },
  "name": "메신저",
  "requestedPermissions": [
    "database",
    "platform:directory:read",
    "platform:files:read",
    "platform:files:write",
    "platform:notifications:write"
  ],
  "resources": {
    "database": "postgresql"
  },
  "runtime": {
    "profile": "rust-web-v1"
  },
  "ui": {
    "contractVersion": "miy.ui/v1alpha1",
    "delivery": "module",
    "moduleEntry": "mf-manifest.json",
    "moduleExport": "./AppRoot"
  },
  "version": "0.1.0",
  "platformEndpoints": {
    "notificationCheck": "/platform/notification-check",
    "homeCard": "/platform/home-card"
  },
  "panels": [
    {
      "id": "conversations",
      "title": "메신저",
      "path": "/widgets/conversations"
    }
  ]
}
